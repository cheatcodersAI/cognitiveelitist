---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<p>&copy; {today.getFullYear()} Cognitive Elitist. A <a href="https://cheatcoders.ai">CheatCoders</a> project.</p>
		<p class="tagline">Tools for minds that work different.</p>
	</div>
</footer>
<style>
	footer {
		padding: 3em 1em;
		background: var(--bg-card);
		border-top: 1px solid var(--border);
		text-align: center;
	}
	.footer-content {
		max-width: 720px;
		margin: 0 auto;
	}
	footer p {
		color: var(--text-muted);
		margin: 0.5em 0;
		font-size: 0.9em;
	}
	footer a {
		color: var(--accent);
	}
	.tagline {
		font-style: italic;
	}
</style>
